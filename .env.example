# ==========================================
# ResearchMate AI - Environment Variables
# ==========================================

# =============
# API Keys (Choose one or multiple)
# =============
# Google Gemini (FREE - Recommended for development)
# Get free API key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here

# OpenAI (Paid - Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Paid - Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============
# Database
# =============
POSTGRES_USER=researchmate
POSTGRES_PASSWORD=researchmate_password_change_in_production
POSTGRES_DB=researchmate
DATABASE_URL=postgresql+asyncpg://researchmate:researchmate_password@localhost:5432/researchmate

# =============
# Redis
# =============
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis_password_change_in_production

# =============
# ChromaDB
# =============
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# =============
# JWT Authentication
# =============
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============
# File Upload
# =============
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.pdf

# =============
# Application
# =============
ENVIRONMENT=development  # development | production | testing
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============
# Frontend
# =============
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# =============
# AI Configuration
# =============
# LLM Provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini Models (FREE)
# - gemini-pro (text only, free)
# - gemini-1.5-flash (fast, multimodal, free)
# - gemini-1.5-pro (advanced, multimodal, free with limits)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Models (if using OpenAI)
OPENAI_MODEL=gpt-4o-mini

# Embedding Model (FREE - runs locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# =============
# RAG Configuration
# =============
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# =============
# Rate Limiting
# =============
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# =============
# Logging
# =============
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log

# =============
# Production Only
# =============
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem
# SENTRY_DSN=your-sentry-dsn-here

# persistent runs Chroma inside the API process; http uses CHROMA_HOST/PORT.
CHROMA_MODE=persistent


# Local processing settings (Render uses its own environment variables).
# Keep local/chroma to reuse existing local paper indexes.
EMBEDDING_PROVIDER=local
VECTOR_STORE_MODE=chroma
EMBEDDING_BATCH_SIZE=4
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MAX_DOCUMENT_PAGES=100
MAX_DOCUMENT_CHUNKS=1000
