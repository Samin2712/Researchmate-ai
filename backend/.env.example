# Local development: no PostgreSQL, Redis, or separate Chroma server required.
# Values here override the root .env. The npm launcher uses this DATABASE_URL;
# set RESEARCHMATE_DATABASE_URL to deliberately override it from your terminal.
DATABASE_URL=sqlite+aiosqlite:///./test.db
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./data/chroma
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=generate-a-local-secret
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local
VECTOR_STORE_MODE=chroma
EMBEDDING_BATCH_SIZE=4
# Render: use a managed PostgreSQL DATABASE_URL, EMBEDDING_PROVIDER=gemini,
# VECTOR_STORE_MODE=database, and requirements-hosted.txt. See docs/RENDER_DEPLOYMENT.md.


# Local processing settings (Render uses its own environment variables).
# Keep local/chroma to reuse existing local paper indexes.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MAX_DOCUMENT_PAGES=100
MAX_DOCUMENT_CHUNKS=1000
